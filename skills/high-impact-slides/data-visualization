## pptxgenjs implementation patterns

When building charts in pptxgenjs, use these settings to match the theme.

### Line chart
```javascript
slide.addChart(pptx.ChartType.line, data, {
  x: 0.6, y: 1.2, w: 5.5, h: 3.5,
  lineDataSymbol: 'none',
  lineSmooth: false,
  chartColors: ['B85042', 'A89F96'], // accent first, gray for secondary
  showLegend: true,
  legendPos: 'b',
  legendFontSize: 10,
  legendColor: '7A7874',
  valAxisLineColor: 'D6D1C8',
  catAxisLineColor: 'D6D1C8',
  valGridLine: { style: 'solid', color: 'E0DBD4', pt: 0.5 },
  catGridLine: { style: 'none' },
  showValue: false,
  dataLabelFontSize: 10,
  dataLabelColor: '2C2C2A',
  valAxisLabelColor: '7A7874',
  catAxisLabelColor: '7A7874',
  valAxisLabelFontSize: 10,
  catAxisLabelFontSize: 10,
});
```

### Bar / column chart
```javascript
slide.addChart(pptx.ChartType.bar, data, {
  x: 0.6, y: 1.2, w: 5.5, h: 3.5,
  barDir: 'col', // use 'bar' for horizontal
  barGapWidthPct: 50,
  chartColors: ['B85042'], // single accent; add 'A89F96' for second series
  showLegend: false,
  valGridLine: { style: 'solid', color: 'E0DBD4', pt: 0.5 },
  catGridLine: { style: 'none' },
  valAxisLineColor: 'D6D1C8',
  catAxisLineColor: 'D6D1C8',
  showValue: true,
  dataLabelFontSize: 10,
  dataLabelColor: '2C2C2A',
  dataLabelPosition: 'outEnd',
  valAxisLabelColor: '7A7874',
  catAxisLabelColor: '7A7874',
  valAxisLabelFontSize: 10,
  catAxisLabelFontSize: 10,
});
```

### Donut chart
```javascript
slide.addChart(pptx.ChartType.doughnut, data, {
  x: 1.5, y: 1.0, w: 4.0, h: 4.0,
  holeSize: 60,
  chartColors: ['B85042', 'A89F96', 'C8BFB4', 'E0DBD4'], // accent + neutrals
  showLegend: true,
  legendPos: 'b',
  legendFontSize: 10,
  legendColor: '7A7874',
  showValue: true,
  dataLabelFontSize: 11,
  dataLabelColor: 'FAFAF8',
  dataLabelPosition: 'ctr',
});
```

### Stat callout (text-based, not a chart object)
```javascript
// Big number
slide.addText('3×', {
  x: 1.0, y: 1.5, w: 8.0, h: 1.8,
  fontSize: 72,
  fontFace: 'Palatino',
  color: 'B85042', // accent color
  align: 'center',
  bold: false,
});
// Label
slide.addText('faster occupancy', {
  x: 1.0, y: 3.2, w: 8.0, h: 0.5,
  fontSize: 12,
  fontFace: 'Calibri',
  color: '7A7874',
  align: 'center',
});
// Supporting statement
slide.addText('Co-working vs. traditional office, Metro Manila 2024', {
  x: 1.0, y: 3.7, w: 8.0, h: 0.4,
  fontSize: 14,
  fontFace: 'Calibri',
  color: '2C2C2A',
  align: 'center',
});
```

